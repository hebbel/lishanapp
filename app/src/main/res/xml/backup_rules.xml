<?xml version="1.0" encoding="utf-8"?>
<!--
   Regler for Androids automatiske backup (Android 11 og ældre).
   Login-tokens tages ikke med: de er krypteret med en nøgle i Keystore, som ikke følger med til
   en anden telefon, og brugeren skal logge ind igen dér.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="lishan_auth.xml" />
</full-backup-content>
