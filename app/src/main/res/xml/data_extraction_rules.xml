<?xml version="1.0" encoding="utf-8"?>
<!--
   Regler for backup og flytning til ny telefon (Android 12 og nyere).
   Login-tokens tages ikke med (se backup_rules.xml).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="lishan_auth.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="lishan_auth.xml" />
    </device-transfer>
</data-extraction-rules>
